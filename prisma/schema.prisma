// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  userID         Int     @id @default(autoincrement())
  username       String  @unique
  pswd           String
  firstname      String
  lastname       String
  school         String?
  email          String  @unique
  volunteerHours Int     @default(0)
  eventsAttended Int     @default(0)
  pfpPath        String?

  favoriteOrgs    UserFavorites[]
  registeredPosts UserRegistrations[]
}

model Organization {
  orgID   Int    @id @default(autoincrement())
  orgName String
  pswd    String
  email   String  @unique
  phoneNumber String?
  address     String?
  website     String?
  linkedin    String?
  pfpPath     String?

  Post Post[]
  favoritedBy UserFavorites[]
}

model Post {
  postID           Int          @id @default(autoincrement())
  orgID            Int
  org              Organization @relation(fields: [orgID], references: [orgID])
  eventDate        DateTime
  title            String
  description      String
  hours            Float        @default(0)
  postDate         DateTime     @default(now())
  eventLocation    String
  numberInterested Int          @default(0)
  thumbnailPath    String?
  finished         Boolean      @default(false)
  updates          String       @default("")

  registrations UserRegistrations[]
}

model UserFavorites {
  userID Int
  orgID  Int

  user User         @relation(fields: [userID], references: [userID])
  org  Organization @relation(fields: [orgID], references: [orgID])

  @@id([userID, orgID]) // ✅ composite primary key
}

model UserRegistrations {
  userID Int
  postID Int

  user User @relation(fields: [userID], references: [userID])
  post Post @relation(fields: [postID], references: [postID])

  @@id([userID, postID]) // ✅ composite primary key
}

